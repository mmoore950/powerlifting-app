{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local detector prediction export",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "coordinateSpace", "modelID", "runs"],
  "properties": {
    "schemaVersion": { "const": 1 }, "coordinateSpace": { "const": "upright-normalized-top-left" },
    "modelID": { "type": "string", "minLength": 1, "maxLength": 200 },
    "runs": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "time": {
      "type": "object", "additionalProperties": false, "required": ["value", "timescale", "epoch"],
      "properties": { "value": { "type": "string", "pattern": "^-?[0-9]+$" }, "timescale": { "type": "integer", "minimum": 1, "maximum": 2147483647 }, "epoch": { "type": "integer", "minimum": 0 } }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp", "point", "confidence", "kind", "targetID"],
      "properties": {
        "timestamp": { "$ref": "#/$defs/time" }, "point": { "oneOf": [{ "$ref": "#/$defs/point" }, { "type": "null" }] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "kind": { "enum": ["automatic", "tracked", "lost"] }, "targetID": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["clipID", "sha256", "mode", "synthetic", "uprightWidth", "uprightHeight", "elapsedSeconds", "samples"],
      "properties": {
        "clipID": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mode": { "enum": ["automatic", "manual-vision"] }, "synthetic": { "type": "boolean" },
        "uprightWidth": { "type": "integer", "minimum": 1, "maximum": 8192 }, "uprightHeight": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "elapsedSeconds": { "type": "number", "minimum": 0 },
        "samples": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/sample" } }
      }
    }
  }
}
